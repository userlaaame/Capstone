# Base URL the frontend calls. Must start with VITE_ or Vite will not expose it
# to client code, and it is read at BUILD time; restart the dev server after
# changing it.
VITE_API_URL=https://<your-site-name>.onrender.com

# For local development against a backend running on your own machine, comment
# the line above and use this instead. src/api/client.js falls back to this same
# URL if VITE_API_URL is unset.
# VITE_API_URL=http://localhost:3000
